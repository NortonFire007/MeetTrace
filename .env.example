# MeetTrace Environment Configuration Template
# Copy this file to .env and fill in your API key:
#   copy .env.example .env
#
# DO NOT commit your actual .env file to Git (already excluded in .gitignore).

# Google Gemini API Key for AI meeting summaries
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Default Gemini model to use for summaries
# Available models:
#   - gemini-3.8-flash (Recommended: latest, fastest, agentic reasoning)
#   - gemini-3.7-flash (High speed, structured output)
#   - gemini-2.5-flash
#   - gemini-2.5-pro
#   - gemini-2.0-flash
#   - gemini-1.5-flash
GEMINI_MODEL=gemini-3.8-flash
